+    /*
+     * A pad whose configuration the BIOS locked (PADCFGLOCK) silently ignores the
+     * write. Report that instead of claiming success.
+     */
+    UInt32 readback = readl(reg);
+    if ((readback & PADCFG0_IRQ_TYPE_MASK) != (value & PADCFG0_IRQ_TYPE_MASK)) {
+        IOLog("%s::Pad %u ignored IRQ type 0x%x (PADCFG0 0x%08x, wanted 0x%08x, lock %d)\n",
+              getName(), pin, type, readback, value, intel_pad_locked(pin));
+        return false;
+    }
     return true;
 }
 
+/**
+ * Make sure a registered pin is still owned by the GPIO driver and still has the
+ * IRQ type its client asked for. The BIOS reprograms pads on S3/S4 resume (often to
+ * its own APIC-routing defaults), so this runs after wake and before a client
+ * enables the interrupt.
+ *
+ * @param pin Hardware pin number.
+ * @param log Log the result even when nothing had to change.
+ */
+void VoodooGPIOIntel::intel_gpio_reprogram_pin(unsigned pin, bool log) {
+    struct intel_community *community = intel_get_community(pin);
+    if (!community || !community->interruptTypes)
+        return;
+
+    unsigned communityidx = pin - community->pin_base;
+    unsigned type = community->interruptTypes[communityidx];
+    if (!type)
+        return;
+
+    /* Takes host ownership back if the BIOS returned the pad to ACPI mode */
+    bool acpi = intel_pad_acpi_mode(pin);
+
+    UInt32 before = 0, after = 0;
+    bool was_ok = intel_gpio_irq_type_applied(pin, type, &before);
+    bool ok = was_ok;
+    if (!was_ok) {
+        intel_gpio_irq_set_type(pin, type);
+        ok = intel_gpio_irq_type_applied(pin, type, &after);
+    } else {
+        after = before;
+    }
+
+    if (log || !was_ok)
+        IOLog("%s::Pad %u type 0x%x: PADCFG0 0x%08x -> 0x%08x (%s%s)\n", getName(), pin, type, before, after,
+              was_ok ? "unchanged" : (ok ? "reprogrammed" : "reprogram FAILED, pad locked?"),
+              acpi ? ", still owned by ACPI" : "");
+}
