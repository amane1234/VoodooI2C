+// Clients can mask a level interrupt from inside their notification. Dispatch
+// on the GPIO work loop so that this operation can re-enter its gate safely.
+class GPIOParentInterrupt : public IOInterruptEventSource {
+    OSDeclareDefaultStructors(GPIOParentInterrupt);
+public:
+    bool retryMask = false;
+    IOReturn setLine(bool on) {
+        // Keep the level source from re-enabling itself after a last-pin mask.
+        explicitDisable = !on;
+        IOReturn ret = on ? provider->enableInterrupt(intIndex) : provider->disableInterrupt(intIndex);
+        retryMask = !on && ret != kIOReturnSuccess;
+        if (ret == kIOReturnSuccess)
+            enabled = on;
+        if (on && ret != kIOReturnSuccess)
+            explicitDisable = true;
+        return ret;
+    }
+    bool attachTo(IOService* driver, Action action, IOService* nub) {
+        return init(driver, action, nub, 0);
+    }
+};
+OSDefineMetaClassAndStructors(GPIOParentInterrupt, IOInterruptEventSource);
+
