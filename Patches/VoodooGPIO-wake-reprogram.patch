+     */
+    for (unsigned int idx = 0; idx < registered_pin_list->getCount(); idx++) {
+        OSNumber* registered_pin = OSDynamicCast(OSNumber, registered_pin_list->getObject(idx));
+        if (!registered_pin)
+            continue;
+
+        unsigned hw_pin = registered_pin->unsigned32BitValue();
+        struct intel_community *community = intel_get_community(hw_pin);
+        if (!community || !community->pinInterruptEnabled)
+            continue;
+
+        intel_gpio_reprogram_pin(hw_pin, true);
+        intel_gpio_irq_mask_unmask(hw_pin, !community->pinInterruptEnabled[hw_pin - community->pin_base]);
+    }
 }
 
