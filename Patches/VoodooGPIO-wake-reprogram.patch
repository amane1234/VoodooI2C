@@ -300,6 +300,36 @@ void VoodooGPIOIntel::intel_gpio_irq_mask_unmask(unsigned pin, bool mask) {
  * @param pin Hardware GPIO pin number to set its type.
  * @param type Type to set.
  */
+/* RXEVCFG, RXINV and PMODE as intel_gpio_irq_set_type() programs them for @type */
+static UInt32 intel_gpio_irq_type_bits(unsigned type) {
+    if ((type & IRQ_TYPE_EDGE_BOTH) == IRQ_TYPE_EDGE_BOTH)
+        return PADCFG0_RXEVCFG_EDGE_BOTH << PADCFG0_RXEVCFG_SHIFT;
+    if (type & IRQ_TYPE_EDGE_FALLING)
+        return (PADCFG0_RXEVCFG_EDGE << PADCFG0_RXEVCFG_SHIFT) | PADCFG0_RXINV;
+    if (type & IRQ_TYPE_EDGE_RISING)
+        return PADCFG0_RXEVCFG_EDGE << PADCFG0_RXEVCFG_SHIFT;
+    if (type & IRQ_TYPE_LEVEL_MASK)
+        return (type & IRQ_TYPE_LEVEL_LOW) ? PADCFG0_RXINV : 0;
+    return PADCFG0_RXEVCFG_DISABLED << PADCFG0_RXEVCFG_SHIFT;
+}
+
+#define PADCFG0_IRQ_TYPE_MASK (PADCFG0_RXEVCFG_MASK | PADCFG0_RXINV | PADCFG0_PMODE_MASK)
+
+/**
+ * Check whether the pad currently has the configuration @type needs.
+ * @param padcfg0 Receives the current PADCFG0 value (may be nullptr).
+ */
+bool VoodooGPIOIntel::intel_gpio_irq_type_applied(unsigned pin, unsigned type, UInt32 *padcfg0) {
+    IOVirtualAddress reg = intel_get_padcfg(pin, PADCFG0);
+    if (!reg)
+        return false;
+
+    UInt32 value = readl(reg);
+    if (padcfg0)
+        *padcfg0 = value;
+    return (value & PADCFG0_IRQ_TYPE_MASK) == intel_gpio_irq_type_bits(type);
+}
